// Matilde sync server. See README.md for setup and PROTOCOL.md for the API.
//
// DOMAIN: matilde.page. Production serves https://sync.matilde.page, staging
// https://sync-staging.matilde.page (custom domains: `wrangler deploy` creates the
// DNS records and certificates). Sign-in mail comes from sign-in@matilde.page.
//
// MAIL: staging and production send through Cloudflare Email Service (Email Sending,
// public beta, Workers Paid) via the `send_email` binding EMAIL. No API key. The binding
// has no destination restriction, so once matilde.page is onboarded for Email Sending it
// can mail any address; `allowed_sender_addresses` pins the sender to sign-in@. Onboarding
// Email Routing is not enough: without Email Sending (records on cf-bounce.matilde.page)
// sends to unverified addresses fail with E_RECIPIENT_NOT_ALLOWED. Fallback:
// set MAIL_PROVIDER to "resend" and add the RESEND_API_KEY secret (README, "Mail").
//
// Secrets are never in this file. See README.md, "Secrets", for `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matilde-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": { "enabled": true },

  // Top level = local development and tests (`wrangler dev`, vitest).
  "vars": {
    "ENVIRONMENT": "development",
    "MAIL_PROVIDER": "console",
    "MAIL_FROM": "Matilde <sign-in@matilde.page>",
    // Local workerd does not implement jurisdictions; staging and production set "eu".
    "DO_JURISDICTION": "",
    "MIN_CLIENT_BUILD": "0",
    "GLOBAL_DAILY_CODE_CAP": "2000",
    // In-app feedback (docs/feedback.md). Messages per network per hour, and per day overall.
    "FEEDBACK_PER_IP_HOUR": "5",
    "GLOBAL_DAILY_FEEDBACK_CAP": "200",
    // Linear team and label ids (not secret; the API key is the LINEAR_API_KEY secret).
    // Empty = feedback is stored in D1 but not delivered / no label.
    "LINEAR_TEAM_ID": "",
    "LINEAR_LABEL_BUG": "",
    "LINEAR_LABEL_IDEA": "",
    "LINEAR_LABEL_OTHER": "",
    // Optional label put on every feedback issue, on top of the kind label.
    "LINEAR_LABEL_FEEDBACK": "",
    // Optional project and workflow state (Triage) for new feedback issues.
    "LINEAR_PROJECT_ID": "",
    "LINEAR_STATE_ID": ""
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "matilde-directory-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "matilde-blobs-dev" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "USER_SYNC", "class_name": "UserSync" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserSync"] }],
  // Every 15 minutes: retry queued feedback. Once a day (the 03:15 UTC run): clean up expired
  // codes, rate counters and sessions. One trigger per environment keeps within the plan's cron limit.
  "triggers": { "crons": ["*/15 * * * *"] },

  "env": {
    "staging": {
      "name": "matilde-sync-staging",
      "routes": [{ "pattern": "sync-staging.matilde.page", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "MAIL_PROVIDER": "cloudflare",
        "MAIL_FROM": "Matilde <sign-in@matilde.page>",
        "DO_JURISDICTION": "eu",
        "MIN_CLIENT_BUILD": "0",
        "GLOBAL_DAILY_CODE_CAP": "200",
        // In-app feedback (docs/feedback.md). Messages per network per hour, and per day overall.
        "FEEDBACK_PER_IP_HOUR": "5",
        "GLOBAL_DAILY_FEEDBACK_CAP": "50",
        // Linear team and label ids (not secret; the API key is the LINEAR_API_KEY secret).
        // Empty = feedback is stored in D1 but not delivered / no label.
        // Team "Gontsolov Labs" (GON); labels "Bug" and "Feature". "Something else" gets no kind label.
        "LINEAR_TEAM_ID": "dea29b62-97d3-4fdc-a6c4-46520e9ab272",
        "LINEAR_LABEL_BUG": "fb091bb1-52b1-4bfd-aa12-0735ea655e93",
        "LINEAR_LABEL_IDEA": "af5c12d6-0a71-4abf-bb7f-5901b6b1699b",
        "LINEAR_LABEL_OTHER": "",
        // Optional label put on every feedback issue, on top of the kind label (e.g. a "Feedback" label).
        "LINEAR_LABEL_FEEDBACK": "",
        // Project "Matilde" and workflow state "Triage" (Triage is enabled on the team).
        // Dropped automatically for one retry if Linear rejects them.
        "LINEAR_PROJECT_ID": "8ad01f26-33e2-4aad-bae4-a8ceff068ab4",
        "LINEAR_STATE_ID": "d782f669-93e4-4718-a532-be3cbdd1f130"
      },
      "d1_databases": [
        // Created with: wrangler d1 create matilde-directory-staging --jurisdiction eu
        { "binding": "DB", "database_name": "matilde-directory-staging", "database_id": "f5c5f043-7aaa-4b11-8fb4-64f576577613", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        // Created with: wrangler r2 bucket create matilde-blobs-staging --jurisdiction eu
        { "binding": "BLOBS", "bucket_name": "matilde-blobs-staging", "jurisdiction": "eu" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "USER_SYNC", "class_name": "UserSync" }]
      },
      // Cloudflare Email Service. No `allowed_destination_addresses`/`destination_address`:
      // sign-in codes go to arbitrary users. Needs matilde.page onboarded for Email Sending.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["sign-in@matilde.page"] }],
      "triggers": { "crons": ["*/15 * * * *"] }
    },
    "production": {
      "name": "matilde-sync",
      "routes": [{ "pattern": "sync.matilde.page", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "MAIL_PROVIDER": "cloudflare",
        "MAIL_FROM": "Matilde <sign-in@matilde.page>",
        "DO_JURISDICTION": "eu",
        "MIN_CLIENT_BUILD": "0",
        "GLOBAL_DAILY_CODE_CAP": "2000",
        // In-app feedback (docs/feedback.md). Messages per network per hour, and per day overall.
        "FEEDBACK_PER_IP_HOUR": "5",
        "GLOBAL_DAILY_FEEDBACK_CAP": "200",
        // Linear team and label ids (not secret; the API key is the LINEAR_API_KEY secret).
        // Empty = feedback is stored in D1 but not delivered / no label.
        // Team "Gontsolov Labs" (GON); labels "Bug" and "Feature". "Something else" gets no kind label.
        "LINEAR_TEAM_ID": "dea29b62-97d3-4fdc-a6c4-46520e9ab272",
        "LINEAR_LABEL_BUG": "fb091bb1-52b1-4bfd-aa12-0735ea655e93",
        "LINEAR_LABEL_IDEA": "af5c12d6-0a71-4abf-bb7f-5901b6b1699b",
        "LINEAR_LABEL_OTHER": "",
        // Optional label put on every feedback issue, on top of the kind label (e.g. a "Feedback" label).
        "LINEAR_LABEL_FEEDBACK": "",
        // Project "Matilde" and workflow state "Triage" (Triage is enabled on the team).
        // Dropped automatically for one retry if Linear rejects them.
        "LINEAR_PROJECT_ID": "8ad01f26-33e2-4aad-bae4-a8ceff068ab4",
        "LINEAR_STATE_ID": "d782f669-93e4-4718-a532-be3cbdd1f130"
      },
      "d1_databases": [
        // Created with: wrangler d1 create matilde-directory --jurisdiction eu
        { "binding": "DB", "database_name": "matilde-directory", "database_id": "9cd3c32d-813d-4fd1-9fef-d5fda797a381", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        // Created with: wrangler r2 bucket create matilde-blobs --jurisdiction eu
        { "binding": "BLOBS", "bucket_name": "matilde-blobs", "jurisdiction": "eu" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "USER_SYNC", "class_name": "UserSync" }]
      },
      // Cloudflare Email Service. No `allowed_destination_addresses`/`destination_address`:
      // sign-in codes go to arbitrary users. Needs matilde.page onboarded for Email Sending.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["sign-in@matilde.page"] }],
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}

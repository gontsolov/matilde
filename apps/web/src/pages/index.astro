---
import Base from "../layouts/Base.astro";
import AppPreview from "../components/AppPreview.astro";
import DownloadButton from "../components/DownloadButton.astro";
import FloatingDownload from "../components/FloatingDownload.astro";
import PenMark from "../components/PenMark.astro";

const points = [
  "Plain Markdown files, in a folder on your Mac.",
  "Branch a draft to try another version, and keep both.",
  "Your own notes in the margin, next to Matilde's.",
];

const privacy = [
  {
    title: "On your Mac first.",
    text: "Your writing is plain files in a folder on your Mac. Sync is optional and off until you turn it on.",
  },
  {
    title: "Locked before it leaves.",
    text: "When you sync, your notes are encrypted on your Mac before they're sent. The key stays with you, so no one else can read your writing, not even someone who broke into the servers.",
  },
  {
    title: "Kept in the EU.",
    text: "Synced notes are stored in the EU. The server sees your email address and how much you sync, never what you write.",
  },
  {
    title: "Your Matilde key matters.",
    text: "Twelve words to keep somewhere safe. If you lose all your devices and the key, no one can unlock your synced notes.",
  },
];
---

<Base
  title="Matilde: a quiet writing app for the Mac"
  description="You write every word. Matilde reads along like a thoughtful editor, asks questions and leaves notes in the margin."
>
  <main>
    <section class="mx-auto flex max-w-5xl flex-col items-start px-6 pt-16 text-left sm:items-center sm:pt-24 sm:text-center">
      <img src="/icon.png" alt="" width="76" height="76" class="mb-8 size-[76px]" />
      <h1 class="max-w-3xl text-[40px] font-medium leading-[1.08] tracking-[-0.015em] sm:text-[56px]">
        You write every word.<br />Matilde reads along.
      </h1>
      <p class="mt-6 max-w-[44rem] text-[18px] leading-[1.55] text-ink/85 sm:text-[19.5px]">
        Matilde is a quiet writing app for the Mac. It reads along like a thoughtful editor: it asks questions
        and leaves notes in the margin. It won't write your paragraphs or make your decisions. The thinking stays yours.
      </p>
      <div class="mt-9">
        <DownloadButton id="hero-download" />
      </div>
    </section>

    <section class="mx-auto mt-16 max-w-[78rem] px-4 sm:mt-20 sm:px-6">
      <AppPreview />
    </section>

    <section class="mx-auto mt-20 max-w-3xl px-6">
      <ul class="grid gap-4 text-center font-sans text-[14.5px] text-muted sm:grid-cols-3 sm:gap-8">
        {points.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section class="mx-auto mt-24 max-w-2xl px-6" aria-labelledby="privacy-heading">
      <div class="border-t border-rule pt-14">
        <h2 id="privacy-heading" class="text-[28px] font-medium tracking-[-0.01em]">
          Your writing stays <PenMark>yours</PenMark>.
        </h2>
        <dl class="mt-7 space-y-5 text-[17.5px] leading-[1.6]">
          {
            privacy.map((item) => (
              <div>
                <dt class="inline font-semibold">{item.title}</dt>{" "}
                <dd class="inline text-ink/85">{item.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 text-[15.5px] leading-[1.6] text-muted">
          There are two exceptions, both off until you turn them on. Ask Matilde works through your own Langdock
          account: the page you're on is sent to Langdock whenever Matilde reads it. And an AI tool you connect
          (below) reads your notes through the Matilde server, which decrypts them for that tool while it's connected.
          Neither is covered by sync's encryption.
        </p>
        <p class="mt-6 font-sans text-[14px]">
          <a href="/privacy" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">How privacy works →</a>
        </p>
      </div>
    </section>
    <section class="mx-auto mt-24 max-w-2xl px-6" aria-labelledby="ai-tools-heading">
      <div class="border-t border-rule pt-14">
        <h2 id="ai-tools-heading" class="text-[28px] font-medium tracking-[-0.01em]">
          Works with your AI tools, if you want.
        </h2>
        <p class="mt-4 text-[17.5px] leading-[1.6] text-ink/85">
          Connect Langdock, Claude, ChatGPT, Cursor or another tool that speaks MCP to your synced notes, at{" "}
          <code class="font-sans text-[15.5px]">mcp.matilde.page/mcp</code>. Ask it to find a passage you half remember,
          pull together your notes on a topic or leave a comment in the margin. You choose what each tool may do (reading,
          comments, new notes, and editing only if you tick it) and for how long, and you can disconnect it any time in
          Settings.
        </p>
        <p class="mt-4 text-[15.5px] leading-[1.6] text-muted">
          It's off until you connect a tool. While one is connected, the Matilde server decrypts your notes to answer
          it, and what the tool reads goes to the company behind it.{" "}
          <a href="/privacy#ai-tools" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">The details</a>.
        </p>
      </div>
    </section>
    <section class="mx-auto mt-24 max-w-2xl px-6" aria-labelledby="ios-heading">
      <div class="flex flex-col items-start gap-10 border-t border-rule pt-14 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-md">
          <p class="inline-flex items-center rounded-full border border-rule bg-sidebar px-2.5 py-0.5 font-sans text-[12px] font-medium tracking-[0.01em] text-muted">
            Coming soon
          </p>
          <h2 id="ios-heading" class="mt-4 text-[28px] font-medium tracking-[-0.01em]">
            Matilde is coming to iPhone.
          </h2>
          <p class="mt-4 text-[17.5px] leading-[1.6] text-ink/85">
            Pick up a draft on the train and finish it at your desk. Your notes sync between your Mac and iPhone,
            end-to-end encrypted, so they stay yours on both.
          </p>
        </div>
        <div
          aria-hidden="true"
          class="relative hidden h-[176px] w-[88px] shrink-0 rounded-[22px] border border-ink/15 bg-card p-[5px] shadow-[0_1px_2px_rgb(0_0_0/0.04),0_8px_24px_-12px_rgb(0_0_0/0.18)] sm:block"
        >
          <div class="flex h-full flex-col rounded-[17px] bg-paper px-2.5 pt-6">
            <div class="absolute left-1/2 top-[10px] h-[7px] w-[26px] -translate-x-1/2 rounded-full bg-ink/80"></div>
            <div class="font-serif text-[11px] font-medium leading-tight">Letter to Anna</div>
            <div class="mt-2 space-y-[5px]">
              <div class="h-[3px] w-full rounded-full bg-ink/15"></div>
              <div class="h-[3px] w-[85%] rounded-full bg-ink/15"></div>
              <div class="h-[3px] w-[92%] rounded-full bg-ink/15"></div>
              <div class="h-[3px] w-[60%] rounded-full bg-ink/15"></div>
            </div>
            <div class="mt-3 space-y-[5px]">
              <div class="h-[3px] w-[95%] rounded-full bg-ink/15"></div>
              <div class="h-[3px] w-[78%] rounded-full bg-ink/15"></div>
              <div class="h-[3px] w-[40%] rounded-full bg-ink/15"></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <FloatingDownload watch="hero-download" />
</Base>

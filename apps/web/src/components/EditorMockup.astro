---
// An interactive impression of the Matilde editor: the sidebar, a page of writing and Ask Matilde
// margin comments. Visitors can switch notes, fold folders, open a comment's thread and reply;
// the replies are scripted (src/lib/mockup-notes.ts), nothing is generated or sent anywhere.
// Colours, type and spacing follow the app (src/styles/global.css and the sidebar and comment
// margin in apps/macos/Sources/Matilde). Without JavaScript it's a static view of "Letter to Anna".
import { DEFAULT_NOTE, folders } from "../lib/mockup-notes";

const notes = folders.flatMap((folder) => folder.notes);
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const card = "mk-card relative rounded-[10px] border border-rule bg-card p-4 font-sans shadow-[0_2px_6px_rgb(0_0_0/0.04)]";
const flag = "M5 5a5 5 0 0 1 7 0a5 5 0 0 0 7 0v9a5 5 0 0 1 -7 0a5 5 0 0 0 -7 0v-9z";
---

<figure
  class="relative mx-auto flex w-full max-w-[78rem] overflow-hidden rounded-[14px] border border-rule bg-paper text-left shadow-[0_1px_2px_rgb(0_0_0/0.04),0_18px_50px_-18px_rgb(60_50_40/0.28)]"
  aria-label="A preview of the Matilde editor. Pick a note, open one of Matilde's comments and reply to it."
  data-mockup
>
  <!-- Traffic lights float over the sidebar, like the app's hidden title bar. -->
  <div class="absolute left-4 top-[13px] flex items-center gap-2" aria-hidden="true">
    <span class="size-3 rounded-full bg-[#ec6a5e]/80"></span>
    <span class="size-3 rounded-full bg-[#f4bf4f]/80"></span>
    <span class="size-3 rounded-full bg-[#61c554]/80"></span>
  </div>

  <nav class="mk-sidebar hidden w-[236px] shrink-0 bg-sidebar px-2 pb-6 pt-12 font-sans lg:block" aria-label="Sample notes">
    <ul class="space-y-1">
      {
        folders.map((folder) => (
          <li>
            <button
              type="button"
              class="mk-folder flex h-[30px] w-full items-center gap-2 rounded-[5px] px-2 text-[12px] font-medium text-muted"
              aria-expanded="true"
              aria-controls={`mk-folder-${slug(folder.name)}`}
              data-folder
            >
              <svg class="mk-icon-open shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19l2.757 -7.351a1 1 0 0 1 .936 -.649h12.307a1 1 0 0 1 .986 1.164l-.996 5.211a2 2 0 0 1 -1.964 1.625h-14.026a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v2" /></svg>
              <svg class="mk-icon-closed shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></svg>
              <span class="flex-1 truncate text-left">{folder.name}</span>
              <svg class="mk-chevron shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6l6 -6" /></svg>
            </button>
            <ul id={`mk-folder-${slug(folder.name)}`} class="space-y-px">
              {folder.notes.map((note) => (
                <li>
                  <button
                    type="button"
                    class="mk-row block w-full rounded-[5px] px-2 py-[9px] text-left"
                    data-note-button={note.id}
                    aria-current={note.id === DEFAULT_NOTE ? "true" : undefined}
                  >
                    <span class="mk-row-title block truncate text-[13px] font-medium leading-4 text-ink">{note.title}</span>
                    <span class="mt-[5px] flex h-[14px] items-center gap-2 text-[12px] leading-[14px] text-muted">
                      <span class="min-w-0 flex-1 truncate">{note.goal}</span>
                      <span class="shrink-0">{note.edited}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="min-w-0 flex-1 lg:min-h-[47rem]">
    <!-- Small screens: no sidebar, the notes as a row of tabs (hidden until the script runs). -->
    <div class="mk-tabs hidden gap-1.5 overflow-x-auto px-4 pt-11 sm:px-7 font-sans sm:px-10 lg:!hidden" role="group" aria-label="Sample notes" data-tabs>
      {
        notes.map((note) => (
          <button
            type="button"
            class="mk-tab shrink-0 rounded-full px-3 py-1 text-[12.5px] text-muted"
            data-note-button={note.id}
            aria-current={note.id === DEFAULT_NOTE ? "true" : undefined}
          >
            {note.title}
          </button>
        ))
      }
    </div>

    {
      notes.map((note) => (
        <article
          class="grid gap-8 px-7 pb-12 pt-9 sm:px-10 lg:pt-14 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-10 lg:pl-12"
          hidden={note.id !== DEFAULT_NOTE}
          aria-label={note.title}
          data-note-page={note.id}
        >
          <div class="min-w-0">
            <p class="text-[28px] font-bold leading-tight tracking-[-0.01em] sm:text-[31px]">{note.title}</p>
            <p class="mt-2 flex items-center gap-1.5 text-[16px] text-muted">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={flag} /><path d="M5 21v-7" /></svg>
              {note.goal}
            </p>
            <div class="mt-6 space-y-4 text-[17px] leading-[1.6] sm:text-[18px]">
              {note.paragraphs.map((paragraph, index) => {
                const last = note.unfinished && index === note.paragraphs.length - 1;
                return (
                  <p class:list={[last && "text-ink/80"]}>
                    {paragraph.map((segment) =>
                      typeof segment === "string" ? segment : (
                        <span class="mk-passage" data-passage={segment.c}>{segment.t}</span>
                      ),
                    )}
                    {last && <span class="mk-caret" aria-hidden="true" />}
                  </p>
                );
              })}
            </div>
          </div>

          <aside class="relative flex flex-col gap-4" aria-label="Matilde's comments" data-margin>
            {note.comments.map((comment, index) => (
              <div class={card} data-card={comment.id} data-replies={JSON.stringify(comment.replies)}>
                <button type="button" class="mk-card-toggle absolute inset-0 z-[1] rounded-[10px]" aria-expanded="false" aria-controls={`mk-thread-${comment.id}`} hidden>
                  <span class="sr-only">Open Matilde's comment on “{comment.quote}”</span>
                </button>
                <div class="border-l-2 border-accent/50 pl-2.5 font-serif text-[13.5px] italic leading-snug text-muted">{comment.quote}</div>
                <p class="mt-3 text-[11.5px] font-medium uppercase tracking-[0.06em] text-muted">Matilde</p>
                <p class="mt-1 text-[13.5px] leading-relaxed text-ink">{comment.text}</p>
                {index === 0 && <p class="mk-hint mt-2.5 hidden text-[12px] text-muted/80">Try replying</p>}
                <div class="mk-thread" id={`mk-thread-${comment.id}`} hidden>
                  <ol class="mk-messages" aria-live="polite" />
                  <form class="mk-reply mt-3 flex items-center gap-1.5 rounded-md border border-rule py-1 pl-2.5 pr-1">
                    <label class="sr-only" for={`mk-input-${comment.id}`}>Reply to Matilde</label>
                    <input
                      id={`mk-input-${comment.id}`}
                      type="text"
                      autocomplete="off"
                      maxlength="280"
                      placeholder="Try replying…"
                      class="min-w-0 flex-1 bg-transparent py-0.5 text-[12.5px] text-ink outline-none placeholder:text-muted/80"
                    />
                    <button type="submit" class="mk-send rounded-full text-muted" aria-label="Send">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-4.98 3.66l-.163 .01l-.086 .016l-.142 .045l-.113 .054l-.07 .043l-.095 .071l-.058 .054l-4 4l-.083 .094a1 1 0 0 0 1.497 1.32l2.293 -2.293v5.586l.007 .117a1 1 0 0 0 1.993 -.117v-5.585l2.293 2.292l.094 .083a1 1 0 0 0 1.32 -1.497l-4 -4l-.082 -.073l-.089 -.064l-.113 -.062l-.081 -.034l-.113 -.034l-.112 -.02l-.098 -.006z" /></svg>
                    </button>
                  </form>
                </div>
              </div>
            ))}
          </aside>
        </article>
      ))
    }
  </div>
</figure>

<style is:global>
  /* Sidebar rows: hover and selection like the app (ink at 3.5 % and 7.5 %, 5 pt corners). */
  .mk-row,
  .mk-folder,
  .mk-tab {
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .mk-row:hover,
  .mk-folder:hover,
  .mk-tab:hover {
    background: color-mix(in srgb, var(--ink) 3.5%, transparent);
  }
  .mk-row[aria-current="true"],
  .mk-tab[aria-current="true"] {
    background: color-mix(in srgb, var(--ink) 7.5%, transparent);
  }
  .mk-row[aria-current="true"] .mk-row-title {
    font-weight: 600;
  }
  .mk-tab[aria-current="true"] {
    color: var(--ink);
  }
  .mk-chevron {
    transition: transform 0.18s ease;
  }
  .mk-folder[aria-expanded="false"] .mk-chevron {
    transform: rotate(-90deg);
  }
  .mk-folder[aria-expanded="true"] .mk-icon-closed,
  .mk-folder[aria-expanded="false"] .mk-icon-open {
    display: none;
  }
  .mk-tabs {
    scrollbar-width: none;
  }
  /* Without the script the cards can't follow their passages: start them near the first one. */
  @media (min-width: 768px) {
    [data-mockup]:not([data-live]) [data-margin] {
      padding-top: 8.4rem;
    }
  }

  /* A passage Matilde commented on: a quiet accent underline and faint tint, stronger when active. */
  .mk-passage {
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    text-decoration: underline 1.5px color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 5px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-color 0.18s ease, text-decoration-color 0.18s ease;
  }
  [data-live] .mk-passage {
    cursor: pointer;
  }
  [data-live] .mk-passage:hover,
  .mk-passage[data-active] {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    text-decoration-color: var(--accent);
  }

  .mk-card {
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  [data-live] .mk-card:not([data-open]):hover {
    border-color: color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .mk-card[data-open] {
    z-index: 2;
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    box-shadow: 0 6px 24px -10px rgb(40 30 20 / 0.28);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-settled] .mk-card {
      transition: top 0.22s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
  }
  [data-live] .mk-hint {
    display: block;
  }
  .mk-card[data-open] .mk-hint {
    display: none;
  }
  .mk-reply {
    transition: border-color 0.18s ease;
  }
  .mk-reply:focus-within {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .mk-send:hover:not(:disabled),
  .mk-send:focus-visible {
    color: var(--accent);
  }
  .mk-send:disabled {
    opacity: 0.4;
  }

  [data-mockup] [role="button"]:focus-visible,
  [data-mockup] button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 5px;
  }
  [data-mockup] .mk-card-toggle:focus-visible {
    outline-offset: 0;
    border-radius: 10px;
  }

  /* The thread: the visitor's replies as bubbles, Matilde's answers like her comment. */
  .mk-messages:not(:empty) {
    margin-top: 0.85rem;
    display: grid;
    gap: 0.7rem;
  }
  .mk-msg-user {
    justify-self: end;
    max-width: 88%;
    border-radius: 10px;
    background: color-mix(in srgb, var(--ink) 6.5%, transparent);
    padding: 0.4rem 0.7rem;
    font-size: 13.5px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .mk-msg-label {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mk-msg-text {
    margin-top: 0.25rem;
    font-size: 13.5px;
    line-height: 1.625;
  }
  .mk-typing {
    font-size: 12.5px;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mk-typing span {
      animation: mk-dot 1.2s ease-in-out infinite;
    }
    .mk-typing span:nth-child(2) {
      animation-delay: 0.2s;
    }
    .mk-typing span:nth-child(3) {
      animation-delay: 0.4s;
    }
    .mk-caret {
      animation: mk-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes mk-dot {
    0%, 60%, 100% { opacity: 0.25; }
    30% { opacity: 1; }
  }
  @keyframes mk-blink {
    50% { opacity: 0; }
  }
  .mk-caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--accent);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-mockup]");
  if (root) setUp(root);

  function setUp(root: HTMLElement) {
    const wide = window.matchMedia("(min-width: 768px)");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    const pages = [...root.querySelectorAll<HTMLElement>("[data-note-page]")];
    const noteButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-note-button]")];
    const sidebar = root.querySelector<HTMLElement>(".mk-sidebar");
    let page = pages.find((p) => !p.hidden) ?? pages[0];
    let open: HTMLElement | null = null;
    const nextReply = new Map<string, number>();

    root.dataset.live = "";
    root.querySelector<HTMLElement>("[data-tabs]")?.classList.replace("hidden", "flex");
    root.querySelectorAll<HTMLElement>(".mk-card-toggle").forEach((toggle) => (toggle.hidden = false));
    root.querySelectorAll<HTMLElement>(".mk-passage").forEach((passage) => {
      passage.setAttribute("role", "button");
      passage.tabIndex = 0;
      passage.setAttribute("aria-label", `${passage.textContent}. Open Matilde's comment`);
    });

    const parts = (card: HTMLElement) => ({
      toggle: card.querySelector<HTMLButtonElement>(".mk-card-toggle")!,
      thread: card.querySelector<HTMLElement>(".mk-thread")!,
      input: card.querySelector<HTMLInputElement>("input")!,
      send: card.querySelector<HTMLButtonElement>(".mk-send")!,
      messages: card.querySelector<HTMLElement>(".mk-messages")!,
      passage: page.querySelector<HTMLElement>(`[data-passage="${card.dataset.card}"]`),
    });

    // Like the app's comment margin: each card's top lines up with its passage, and a card that
    // would overlap the one above moves down below it. Only while the margin is beside the text.
    function layout() {
      const margin = page.querySelector<HTMLElement>("[data-margin]");
      if (!margin) return;
      const cards = [...margin.querySelectorAll<HTMLElement>("[data-card]")];
      if (!wide.matches) {
        margin.style.minHeight = "";
        for (const card of cards) Object.assign(card.style, { position: "", top: "", left: "", right: "" });
        return;
      }
      const origin = margin.getBoundingClientRect().top;
      let next = 0;
      for (const card of cards) {
        const passage = page.querySelector<HTMLElement>(`[data-passage="${card.dataset.card}"]`);
        if (!passage) continue;
        // The quote's first line sits level with the passage's first line.
        const top = Math.max(next, passage.getBoundingClientRect().top - origin - 16);
        Object.assign(card.style, { position: "absolute", top: `${top}px`, left: "0", right: "0" });
        next = top + card.offsetHeight + 16;
      }
      margin.style.minHeight = `${Math.max(0, next - 16)}px`;
    }

    function select(id: string) {
      collapse(false);
      for (const p of pages) p.hidden = p.dataset.notePage !== id;
      page = pages.find((p) => !p.hidden) ?? page;
      for (const button of noteButtons) {
        if (button.dataset.noteButton === id) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      }
      root!.querySelector<HTMLElement>(`.mk-tab[aria-current="true"]`)?.scrollIntoView({ block: "nearest", inline: "nearest" });
      layout();
    }

    function expand(card: HTMLElement, focus = true) {
      if (open === card) return;
      collapse(false);
      open = card;
      const { toggle, thread, input, passage } = parts(card);
      card.dataset.open = "";
      toggle.setAttribute("aria-expanded", "true");
      toggle.hidden = true;
      thread.hidden = false;
      if (passage) passage.dataset.active = "";
      layout();
      if (focus) input.focus({ preventScroll: true });
      if (!wide.matches) card.scrollIntoView({ block: "nearest", behavior: still.matches ? "auto" : "smooth" });
    }

    function collapse(restoreFocus: boolean) {
      if (!open) return;
      const card = open;
      open = null;
      const { toggle, thread, passage } = parts(card);
      delete card.dataset.open;
      toggle.setAttribute("aria-expanded", "false");
      toggle.hidden = false;
      thread.hidden = true;
      if (passage) delete passage.dataset.active;
      layout();
      if (restoreFocus) toggle.focus({ preventScroll: true });
    }

    function element(tag: string, className: string, text = "") {
      const node = document.createElement(tag);
      node.className = className;
      node.textContent = text;
      return node;
    }

    // A scripted answer: a short "reading" pause, then the reply word by word. No network, no AI.
    function reply(card: HTMLElement, message: string) {
      const { messages, send } = parts(card);
      const replies: string[] = JSON.parse(card.dataset.replies ?? "[]");
      const id = card.dataset.card ?? "";
      const index = nextReply.get(id) ?? 0;
      nextReply.set(id, index + 1);
      const answer = replies[index % replies.length] ?? "";

      const mine = element("li", "mk-msg-user", message);
      messages.append(mine);
      send.disabled = true;
      const typing = element("li", "mk-typing", "Matilde is reading");
      for (let i = 0; i < 3; i++) typing.append(element("span", "", "."));
      window.setTimeout(() => messages.append(typing), 250);

      window.setTimeout(() => {
        typing.remove();
        const item = element("li", "");
        const text = element("p", "mk-msg-text");
        item.append(element("p", "mk-msg-label", "Matilde"), text);
        messages.append(item);
        const words = answer.split(" ");
        if (still.matches) {
          text.textContent = answer;
          send.disabled = false;
          return;
        }
        messages.setAttribute("aria-busy", "true");
        let shown = 0;
        const step = () => {
          text.textContent = words.slice(0, ++shown).join(" ");
          if (shown < words.length) window.setTimeout(step, 45 + Math.random() * 40);
          else {
            messages.removeAttribute("aria-busy");
            send.disabled = false;
          }
        };
        step();
      }, 1100 + Math.random() * 500);
    }

    for (const button of noteButtons) {
      button.addEventListener("click", () => select(button.dataset.noteButton ?? ""));
    }

    root.querySelectorAll<HTMLButtonElement>("[data-folder]").forEach((folder) => {
      folder.addEventListener("click", () => {
        const expanded = folder.getAttribute("aria-expanded") === "true";
        folder.setAttribute("aria-expanded", String(!expanded));
        const list = document.getElementById(folder.getAttribute("aria-controls") ?? "");
        if (list) list.hidden = expanded;
      });
    });

    // Arrow keys walk the sidebar; left and right fold and unfold a folder.
    sidebar?.addEventListener("keydown", (event) => {
      const buttons = [...sidebar.querySelectorAll<HTMLButtonElement>("button")].filter((b) => b.offsetParent !== null);
      const current = document.activeElement as HTMLButtonElement;
      const at = buttons.indexOf(current);
      if (at < 0) return;
      const isFolder = current.hasAttribute("data-folder");
      const expanded = current.getAttribute("aria-expanded") === "true";
      let target: HTMLButtonElement | undefined;
      if (event.key === "ArrowDown") target = buttons[at + 1];
      else if (event.key === "ArrowUp") target = buttons[at - 1];
      else if (event.key === "Home") target = buttons[0];
      else if (event.key === "End") target = buttons[buttons.length - 1];
      else if (event.key === "ArrowLeft" && isFolder && expanded) current.click();
      else if (event.key === "ArrowRight" && isFolder && !expanded) current.click();
      else if (event.key === "ArrowLeft" && !isFolder)
        target = current.closest("ul")?.parentElement?.querySelector<HTMLButtonElement>("[data-folder]") ?? undefined;
      else return;
      event.preventDefault();
      target?.focus();
    });

    for (const card of root.querySelectorAll<HTMLElement>("[data-card]")) {
      const { toggle, input } = parts(card);
      toggle.addEventListener("click", () => expand(card));
      card.querySelector("form")?.addEventListener("submit", (event) => {
        event.preventDefault();
        const { send } = parts(card);
        const message = input.value.trim();
        if (!message || send.disabled) return;
        input.value = "";
        reply(card, message);
      });
    }

    for (const passage of root.querySelectorAll<HTMLElement>(".mk-passage")) {
      const activate = () => {
        const card = passage.closest("[data-note-page]")?.querySelector<HTMLElement>(`[data-card="${passage.dataset.passage}"]`);
        if (!card) return;
        if (open === card) collapse(false);
        else expand(card);
      };
      passage.addEventListener("click", activate);
      passage.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        activate();
      });
    }

    // Clicking anywhere else, or Esc, closes the open thread.
    document.addEventListener("pointerdown", (event) => {
      if (!open) return;
      const target = event.target as Node;
      const passage = page.querySelector(`[data-passage="${open.dataset.card}"]`);
      if (open.contains(target) || passage?.contains(target)) return;
      collapse(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && open) collapse(open.contains(document.activeElement));
    });

    const observer = new ResizeObserver(() => layout());
    for (const p of pages) {
      observer.observe(p);
      p.querySelectorAll("[data-card]").forEach((card) => observer.observe(card));
    }
    wide.addEventListener("change", layout);
    layout();
    document.fonts?.ready.then(layout);
    requestAnimationFrame(() => requestAnimationFrame(() => (root.dataset.settled = "")));
  }
</script>

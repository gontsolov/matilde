---
// A light HTML/CSS impression of the Matilde editor: the sidebar, a page of writing and two Ask
// Matilde margin comments. Colours, type and spacing follow the app (src/styles/global.css and
// the sidebar in apps/macos/Sources/Matilde/MatildeApp.swift). Decorative only.

interface Note {
  title: string;
  goal: string;
  edited: string;
  selected?: boolean;
}
interface Section {
  folder?: string;
  notes: Note[];
}

// One two-line row per note (title above goal and edited time). Loose notes come first, then
// folders, notes newest first, as in SidebarOrder.swift.
const sections: Section[] = [
  { notes: [{ title: "Notes from the move", goal: "No goal set", edited: "4d" }] },
  {
    folder: "Letters",
    notes: [
      { title: "Letter to Anna", goal: "Tell her why I'm moving back.", edited: "now", selected: true },
      { title: "Thank-you note to Mr. Haas", goal: "Short, warm, no fuss.", edited: "2d" },
    ],
  },
  {
    folder: "Essays",
    notes: [
      { title: "On leaving cities", goal: "No goal set", edited: "1w" },
      { title: "The bakery on Linden Street", goal: "What a place remembers.", edited: "3w" },
    ],
  },
];

const highlight =
  "rounded-[3px] bg-accent/[0.07] underline decoration-accent/60 decoration-[1.5px] underline-offset-[5px] [box-decoration-break:clone]";
const card = "rounded-[10px] border border-rule bg-card p-4 font-sans shadow-[0_2px_6px_rgb(0_0_0/0.04)]";
---

<figure
  class="relative mx-auto flex w-full max-w-6xl overflow-hidden rounded-[14px] border border-rule bg-paper shadow-[0_1px_2px_rgb(0_0_0/0.04),0_18px_50px_-18px_rgb(60_50_40/0.28)]"
  aria-label="The Matilde editor: a letter being written, with two questions from Matilde in the margin."
>
  <!-- Traffic lights float over the sidebar, like the app's hidden title bar. -->
  <div class="absolute left-4 top-[13px] flex items-center gap-2" aria-hidden="true">
    <span class="size-3 rounded-full bg-[#ec6a5e]/80"></span>
    <span class="size-3 rounded-full bg-[#f4bf4f]/80"></span>
    <span class="size-3 rounded-full bg-[#61c554]/80"></span>
  </div>

  <div class="hidden w-[232px] shrink-0 bg-sidebar px-2 pb-6 pt-12 font-sans lg:block" aria-hidden="true">
    <div class="space-y-1">
      {
        sections.map((section) => (
          <div class="space-y-px">
            {section.folder && (
              <div class="flex h-[30px] items-center gap-2 px-2 text-[12px] font-medium text-muted">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M5 19l2.757 -7.351a1 1 0 0 1 .936 -.649h12.307a1 1 0 0 1 .986 1.164l-.996 5.211a2 2 0 0 1 -1.964 1.625h-14.026a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v2" /></svg>
                <span class="truncate">{section.folder}</span>
              </div>
            )}
            {section.notes.map((note) => (
              <div class:list={["rounded-[5px] px-2 py-[9px]", note.selected && "bg-ink/[0.075]"]}>
                <p class:list={["truncate text-[13px] leading-4 text-ink", note.selected ? "font-semibold" : "font-medium"]}>
                  {note.title}
                </p>
                <p class="mt-[5px] flex h-[14px] items-center gap-2 text-[12px] leading-[14px] text-muted">
                  <span class="min-w-0 flex-1 truncate">{note.goal}</span>
                  <span class="shrink-0">{note.edited}</span>
                </p>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="relative grid min-w-0 flex-1 gap-8 px-7 pb-12 pt-14 text-left sm:px-10 md:grid-cols-[minmax(0,1fr)_16.5rem] md:gap-9 lg:pl-12"
    data-mockup-page
    aria-hidden="true"
  >
    <div class="min-w-0">
      <p class="text-[28px] font-bold leading-tight tracking-[-0.01em] sm:text-[31px]">Letter to Anna</p>
      <p class="mt-2 flex items-center gap-1.5 text-[16px] text-muted">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5a5 5 0 0 1 7 0a5 5 0 0 0 7 0v9a5 5 0 0 1 -7 0a5 5 0 0 0 -7 0v-9z" /><path d="M5 21v-7" /></svg>
        Tell her why I'm moving back.
      </p>
      <div class="mt-6 space-y-4 text-[17px] leading-[1.6] sm:text-[18px]">
        <p>
          I keep starting this letter and stopping. Not because I don't know what to say, but because every
          version sounds more certain than I feel.
        </p>
        <p>
          The flat is nearly empty now. The plants went to the neighbours, the books to a shop on the corner
          that still smells of the bakery it used to be.{" "}
          <span class={highlight} data-passage="home">The city never really felt like home.</span>
        </p>
        <p>
          What I miss most is the sound of the kitchen on Sunday mornings, and you arguing with the radio as
          if it could hear you.
        </p>
        <p>
          You'll say I'm running back to something that isn't there anymore, and maybe you're right. Mum's
          bicycle is still in your hallway, and the man at the market still keeps the bruised pears for
          whoever asks.{" "}
          <span class={highlight} data-passage="house">I'm not coming back for the house.</span>
        </p>
        <p class="text-ink/80">
          I think I'm coming back for the person I was at that kitchen table<span class="mockup-caret"></span>
        </p>
      </div>
    </div>

    <!-- Cards sit beside their passages on wide screens (positioned by the script below) and stack under the letter otherwise. -->
    <aside class="relative flex flex-col gap-4" data-margin>
      <div class={card} data-anchor="home">
        <div class="border-l-2 border-accent/50 pl-2.5 font-serif text-[13.5px] italic leading-snug text-muted">
          The city never really felt like home.
        </div>
        <p class="mt-3 text-[11.5px] font-medium uppercase tracking-[0.06em] text-muted">Matilde</p>
        <p class="mt-1 text-[13.5px] leading-relaxed text-ink">
          The paragraph before is full of things you loved there: the shop, the plants, the neighbours. Is this
          sentence what you feel, or what's easier to tell her?
        </p>
      </div>
      <div class={card} data-anchor="house">
        <div class="border-l-2 border-accent/50 pl-2.5 font-serif text-[13.5px] italic leading-snug text-muted">
          I'm not coming back for the house.
        </div>
        <p class="mt-3 text-[11.5px] font-medium uppercase tracking-[0.06em] text-muted">Matilde</p>
        <p class="mt-1 text-[13.5px] leading-relaxed text-ink">
          This is the first time you say what you're not coming back for. Will Anna want to hear what you are
          coming back for?
        </p>
        <div class="mt-3 rounded-md border border-rule px-2.5 py-1.5 text-[12.5px] text-muted/80">Reply…</div>
      </div>
    </aside>
  </div>
</figure>

<style>
  .mockup-caret {
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mockup-caret {
      animation: mockup-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes mockup-blink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  // Like the app's comment margin: each card's top lines up with its passage, and a card that would
  // overlap the one above moves down below it. Only when the margin column is beside the text.
  const wide = window.matchMedia("(min-width: 768px)");
  const gap = 16;

  function layout(page: HTMLElement) {
    const margin = page.querySelector<HTMLElement>("[data-margin]");
    if (!margin) return;
    const cards = [...margin.querySelectorAll<HTMLElement>("[data-anchor]")];
    if (!wide.matches) {
      margin.style.minHeight = "";
      for (const card of cards) Object.assign(card.style, { position: "", top: "", left: "", right: "" });
      return;
    }
    const origin = margin.getBoundingClientRect().top;
    let next = 0;
    for (const card of cards) {
      const passage = page.querySelector<HTMLElement>(`[data-passage="${card.dataset.anchor}"]`);
      if (!passage) continue;
      // The quote's first line sits level with the passage's first line.
      const top = Math.max(next, passage.getBoundingClientRect().top - origin - 16);
      Object.assign(card.style, { position: "absolute", top: `${top}px`, left: "0", right: "0" });
      next = top + card.offsetHeight + gap;
    }
    margin.style.minHeight = `${next - gap}px`;
  }

  for (const page of document.querySelectorAll<HTMLElement>("[data-mockup-page]")) {
    const run = () => layout(page);
    run();
    document.fonts?.ready.then(run);
    new ResizeObserver(run).observe(page);
    wide.addEventListener("change", run);
  }
</script>

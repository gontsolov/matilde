---
// The changelog as the home page's editor mock-up (EditorMockup.astro): every release is a note in
// the sidebar, newest first, and opens in the editor pane with Matilde's one-liner in the margin.
// Entries come from changelog/*.md at the repo root, the same files the apps bundle.
//
// Works without JavaScript: the sidebar rows are links to #v0.3.3 and CSS (:target) shows that
// release, or the newest one. Below 1024 px there's no sidebar and every release is listed in turn.
// The script only keeps the page from jumping and marks the current row.
import { render } from "astro:content";
import { anchor, longDate, releases, shortDate, versionLabel } from "../lib/changelog";

const all = await releases();
const pages = await Promise.all(all.map(async (release) => ({ release, Content: (await render(release)).Content })));
// Without the script, the sidebar row of the linked release (:target) is the selected one.
const targetStyles = all
  .map((release) => {
    const scope = `[data-changelog]:not([data-live]):has([id="${anchor(release)}"]:target)`;
    return `${scope} .cl-row[aria-current="true"]{background:transparent}${scope} .cl-row[aria-current="true"] .cl-row-title{font-weight:500}${scope} [data-release-link="${anchor(release)}"]{background:color-mix(in srgb,var(--ink) 7.5%,transparent)}${scope} [data-release-link="${anchor(release)}"] .cl-row-title{font-weight:600}`;
  })
  .join("");
const card = "relative rounded-[10px] border border-rule bg-card p-4 font-sans shadow-[0_2px_6px_rgb(0_0_0/0.04)]";
---

<figure
  class="relative mx-auto flex w-full max-w-[78rem] overflow-hidden rounded-[14px] border border-rule bg-paper text-left shadow-[0_1px_2px_rgb(0_0_0/0.04),0_18px_50px_-18px_rgb(60_50_40/0.28)]"
  aria-label="Matilde's release notes, laid out like the Matilde editor. Pick a release in the sidebar to read it."
  data-changelog
>
  <div class="absolute left-4 top-[13px] flex items-center gap-2" aria-hidden="true">
    <span class="size-3 rounded-full bg-[#ec6a5e]/80"></span>
    <span class="size-3 rounded-full bg-[#f4bf4f]/80"></span>
    <span class="size-3 rounded-full bg-[#61c554]/80"></span>
  </div>

  <nav class="cl-sidebar hidden w-[236px] shrink-0 bg-sidebar px-2 pb-6 pt-12 font-sans lg:block" aria-label="Releases" data-md-skip>
    <p class="flex h-[30px] items-center gap-2 px-2 text-[12px] font-medium text-muted">
      <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19l2.757 -7.351a1 1 0 0 1 .936 -.649h12.307a1 1 0 0 1 .986 1.164l-.996 5.211a2 2 0 0 1 -1.964 1.625h-14.026a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v2" /></svg>
      Releases
    </p>
    <ul class="space-y-px">
      {
        all.map((release, index) => (
          <li>
            <a
              href={`#${anchor(release)}`}
              class="cl-row block rounded-[5px] px-2 py-[9px]"
              data-release-link={anchor(release)}
              aria-current={index === 0 ? "true" : undefined}
            >
              <span class="cl-row-title block truncate text-[13px] font-medium leading-4 text-ink">{release.data.title}</span>
              <span class="mt-[5px] flex h-[14px] items-center gap-2 text-[12px] leading-[14px] text-muted">
                <span class="min-w-0 flex-1 truncate">{versionLabel(release)}</span>
                <span class="shrink-0">{shortDate(release.data.date)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="cl-pages min-w-0 flex-1 lg:min-h-[47rem]">
    {
      pages.map(({ release, Content }) => (
        <article
          id={anchor(release)}
          class="cl-page grid scroll-mt-6 gap-6 px-7 pb-12 pt-11 sm:px-10 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-10 lg:pl-12 lg:pt-14"
          data-release={anchor(release)}
        >
          <div class="min-w-0">
            <h2 class="text-[28px] font-bold leading-tight tracking-[-0.01em] sm:text-[31px]">{release.data.title}</h2>
            <p class="mt-2 flex items-center gap-1.5 text-[16px] text-muted">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" /><path d="M3 6v5.172a2 2 0 0 0 .586 1.414l7.71 7.71a2.41 2.41 0 0 0 3.408 0l5.592 -5.592a2.41 2.41 0 0 0 0 -3.408l-7.71 -7.71a2 2 0 0 0 -1.414 -.586h-5.172a3 3 0 0 0 -3 3z" /></svg>
              <span>
                {release.data.covers ? `Versions ${release.data.covers}` : `Version ${release.data.version}`} ·{" "}
                <time datetime={release.data.date.toISOString().slice(0, 10)}>{longDate(release.data.date)}</time>
              </span>
            </p>
            <div class="cl-body mt-6 text-[17px] leading-[1.6] sm:text-[18px]">
              <Content />
            </div>
          </div>
          {release.data.matilde && (
            <aside class="md:pt-[7.2rem]" aria-label="Matilde's comment" data-md-skip>
              <div class={card}>
                <div class="border-l-2 border-accent/50 pl-2.5 font-serif text-[13.5px] italic leading-snug text-muted">{release.data.title}</div>
                <p class="mt-3 text-[11.5px] font-medium uppercase tracking-[0.06em] text-muted">Matilde</p>
                <p class="mt-1 text-[13.5px] leading-relaxed text-ink">{release.data.matilde}</p>
              </div>
            </aside>
          )}
        </article>
      ))
    }
  </div>
</figure>

<style set:html={targetStyles}></style>

<style is:global>
  /* Sidebar rows: hover and selection like the app (ink at 3.5 % and 7.5 %, 5 pt corners). */
  .cl-row {
    transition: background-color 0.18s ease;
  }
  .cl-row:hover {
    background: color-mix(in srgb, var(--ink) 3.5%, transparent);
  }
  .cl-row[aria-current="true"] {
    background: color-mix(in srgb, var(--ink) 7.5%, transparent);
  }
  .cl-row[aria-current="true"] .cl-row-title {
    font-weight: 600;
  }
  [data-changelog] a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 5px;
  }

  /* The release text: paragraphs and plain bullets in the editor's Newsreader. */
  .cl-body > * + * {
    margin-top: 1rem;
  }
  .cl-body ul {
    list-style: disc;
    padding-left: 1.25em;
  }
  .cl-body li + li {
    margin-top: 0.45rem;
  }
  .cl-body li::marker {
    color: var(--muted);
  }
  .cl-body strong {
    font-weight: 600;
  }
  .cl-body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 4px;
  }

  /* Small screens: every release in turn, divided by a rule. */
  .cl-page + .cl-page {
    border-top: 1px solid var(--rule);
  }

  /* With the sidebar: one release at a time. Without the script, the linked one (:target) or the
     newest; with it, the one the script marks. */
  @media (min-width: 1024px) {
    .cl-page + .cl-page {
      border-top: 0;
    }
    [data-changelog] .cl-page {
      display: none;
    }
    [data-changelog]:not([data-live]) .cl-page:target,
    [data-changelog]:not([data-live]) .cl-pages:not(:has(.cl-page:target)) .cl-page:first-child,
    [data-changelog][data-live] .cl-page[data-current] {
      display: grid;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-changelog]");
  if (root) setUp(root);

  function setUp(root: HTMLElement) {
    const pages = [...root.querySelectorAll<HTMLElement>("[data-release]")];
    const links = [...root.querySelectorAll<HTMLAnchorElement>("[data-release-link]")];
    if (!pages.length) return;

    function select(id: string) {
      const page = pages.find((p) => p.dataset.release === id) ?? pages[0];
      for (const p of pages) p.toggleAttribute("data-current", p === page);
      for (const link of links) {
        if (link.dataset.releaseLink === page.dataset.release) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    }

    select(location.hash.slice(1));
    root.dataset.live = "";

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        const id = link.dataset.releaseLink ?? "";
        history.replaceState(null, "", `#${id}`);
        select(id);
      });
    }
    window.addEventListener("hashchange", () => select(location.hash.slice(1)));

    // Arrow keys walk the releases, like the app's sidebar.
    root.querySelector(".cl-sidebar")?.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key;
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (at < 0) return;
      const target =
        key === "ArrowDown" ? links[at + 1] : key === "ArrowUp" ? links[at - 1] : key === "Home" ? links[0] : key === "End" ? links.at(-1) : undefined;
      if (!target) return;
      event.preventDefault();
      target.focus();
      target.click();
    });
  }
</script>

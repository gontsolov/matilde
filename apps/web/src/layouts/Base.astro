---
import "../styles/global.css";
import { AUTHOR_URL, FEEDBACK_EMAIL, SOURCE_URL } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Link-preview image in public/, 1200×630 (rendered by scripts/og-image.mjs). */
  image?: string;
  imageAlt?: string;
  /** Markdown copy of the page (generated at build time, see integrations/markdown.mjs). */
  markdown?: string;
  /** schema.org JSON-LD for this page. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}
const {
  title,
  description,
  image = "/og-image.png",
  imageAlt = "Matilde: You write every word. Matilde reads along.",
  markdown,
  jsonLd,
  noindex = false,
} = Astro.props;
// build.format "file" makes Astro.url end in /index.html or /privacy.html; the public URLs are / and /privacy.
const path = Astro.url.pathname.replace(/(^|\/)index\.html$/, "$1").replace(/\.html$/, "");
const canonical = new URL(path, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f9f6ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#212222" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="Matilde" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-dvh bg-paper font-serif text-ink">
    <slot />
    <footer class="mx-auto max-w-5xl px-6 pb-10 pt-16 font-sans text-[13px] text-muted">
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/" class="hover:text-ink">Matilde</a>
        <a href="/privacy" class="hover:text-ink">Privacy</a>
        <a href={SOURCE_URL} rel="noopener" class="hover:text-ink">GitHub</a>
        <a href={`mailto:${FEEDBACK_EMAIL}`} class="hover:text-ink">Feedback</a>
        <a href={AUTHOR_URL} rel="noopener" class="hover:text-ink">Built by Filip</a>
      </div>
    </footer>
  </body>
</html>

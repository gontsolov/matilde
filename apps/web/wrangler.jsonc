{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The matilde.page landing page. Separate from the sync server (server/, sync.matilde.page).
  "name": "matilde-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker runs first to redirect www and to count /download and /appcast.xml; everything else is a static file.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "matilde.page", "custom_domain": true },
    { "pattern": "www.matilde.page", "custom_domain": true }
  ],
  // No workers.dev site; pull-request previews use version preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Anonymous daily counts of /download clicks and /appcast.xml update checks (worker/events.ts,
  // docs/stats.md). The dataset is created on the first write; stats.matilde.page reads it.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "matilde_web_events" }],
  // No request logs kept by Workers Observability.
  "observability": { "enabled": false }
}
